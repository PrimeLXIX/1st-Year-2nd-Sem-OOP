        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\ntitle Library \n---\n\nclassDiagram\n    Library_System \&quot;1\&quot; o-- \&quot;*\&quot; Member\n    Library_System \&quot;1\&quot; o-- \&quot;*\&quot; Librarian\n    Library_System \&quot;1\&quot; o-- \&quot;*\&quot; Book\n    Book \&quot;1\&quot; o-- \&quot;*\&quot; Book_Item\n    Book_Rack \&quot;1\&quot; o-- \&quot;*\&quot; Book_Item\n    Library_System \&quot;1\&quot; o-- \&quot;*\&quot; Book_Rack\n    Library_System \&quot;1\&quot; o-- \&quot;*\&quot; Book_Lending\n    Book_Item \&quot;1\&quot; &lt;-- \&quot;1\&quot; Book_Lending\n    Book_Item \&quot;1\&quot; &lt;-- \&quot;1\&quot; Book_Reservation\n    Member \&quot;1\&quot; &lt;-- \&quot;1\&quot; Book_Lending\n    Member \&quot;1\&quot; &lt;-- \&quot;1\&quot; Book_Reservation\n    Library_System \&quot;1\&quot; o-- \&quot;*\&quot; Book_Reservation\n\n    class Library_System{\n        +Book_Information\n        +Members\n        +Library_Members\n        +Loan_Recovery\n        +Add_Member()\n        +Add_Librarians()\n\t+Remove_Members()\n\t+Add_Book()\n\t+Remove_Book()\n\t+Add_BookRack()\n\t+Remove_BookRack()\n\t+Search_Book_by_ISBN()\n\t+Search_Book_by_author()\n\t+Search_Book_by_subject()\n\t+Search_Book_by_BookRack()\n\t+Search_BookRack_Number()\n\t+Search_overdue_Book()\n\t+Pending_Reservation()\n\t+Lending_Books()\n\t+Returning_Books_to_BookRack()\n\t+Reserve_Books()\n        +Borrow_Money()\n    }\n\n    class Book{\n        +Book_Number\n        +ISBN_Number\n        +Book_Title\n        +Author_Name\n        +Book_Subject\n        +Publication_Date\n        +Book_Name\n        +Book_Shelf\n        +Category\n        +Location\n        +Available_Item()\n    }\n\n    class Book_Item{\n        +Book_Number\n        +Status\n        +Bookshelf\n        +Location\n        +Book_Lending()\n        +Book_Reservation()\n        +Check_Availability()\n        +Check_Out()\n    }\n\n    class Book_Rack{\n        +Rack_Number\